  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated user profile document"
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Authorized admin UID registry"
    },
    "/staff_access/{uid}": {
      "schema": { "$ref": "#/entities/StaffAccess" },
      "description": "Verified Staff UID binding to assigned centre and counter"
    },
    "/staff_profiles/{staffId}": {
      "schema": { "$ref": "#/entities/StaffProfile" },
      "description": "Admin-managed staff officer accounts"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItem" },
      "description": "Public citizen service catalog"
    },
    "/centres/{centreId}": {
      "schema": { "$ref": "#/entities/ServiceCentre" },
      "description": "Public service centres directory"
    },
    "/counters/{counterId}": {
      "schema": { "$ref": "#/entities/Counter" },
      "description": "Physical counter operational status"
    },
    "/tokens/{tokenId}": {
      "schema": { "$ref": "#/entities/QueueToken" },
      "description": "Citizen virtual and walk-in queue tokens"
    },
    "/service_change_proposals/{proposalId}": {
      "schema": { "$ref": "#/entities/ServiceChangeProposal" },
      "description": "Staff proposals awaiting Admin review"
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/StaffNotification" },
      "description": "Role-targeted queue and approval alerts"
    },
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Global operational queue settings"
    },
    "/crowd_reports/{reportId}": {
      "schema": { "$ref": "#/entities/CrowdReport" },
      "description": "Citizen crowd reports and staff verifications"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/CentreReview" },
      "description": "Visitor reviews for service centres"
    },
    "/live_queue_updates/{updateId}": {
      "schema": { "$ref": "#/entities/LiveQueueStatusUpdate" },
      "description": "Crowdsourced live radar broadcasts"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable operational audit logs"
    }
  }
}
