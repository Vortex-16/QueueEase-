        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "centreId", "centreName", "crowdLevel", "approxPeopleCount", "reportedWaitMinutes", "notes", "reporterName", "timestamp", "upvotesCount", "staffVerified", "confidenceScore", "visibility", "createdAt", "updatedAt"]
