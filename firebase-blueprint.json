        "maxActiveTokensPerCitizen": { "type": "integer" },
        "crowdDecayHalfLifeMinutes": { "type": "integer" },
        "walkInBufferPerHour": { "type": "integer" },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceBanner": { "type": "string" },
        "updatedAtMillis": { "type": "integer" },
        "updatedByAdmin": { "type": "string" },
        "visibility": { "type": "string", "enum": ["PUBLIC"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["autoNoShowTimeoutMinutes", "maxActiveTokensPerCitizen", "crowdDecayHalfLifeMinutes", "walkInBufferPerHour", "maintenanceMode", "maintenanceBanner", "updatedAtMillis", "updatedByAdmin", "visibility", "createdAt", "updatedAt"]
    },
