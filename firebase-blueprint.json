    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only operational audit trail",
      "type": "object",
      "properties": {
        "timestamp": { "type": "integer" },
        "action": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string", "enum": ["CUSTOMER", "STAFF", "ADMIN"] },
        "actorUid": { "type": "string" },
        "details": { "type": "string" },
        "centreId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
