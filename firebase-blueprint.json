        "timestamp": { "type": "integer" },
        "helpfulCount": { "type": "integer" },
        "verifiedVisitor": { "type": "boolean" },
        "visibility": { "type": "string", "enum": ["PUBLIC"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "centreId", "centreName", "userName", "rating", "reviewText", "visitTag", "queueSpeedRating", "timestamp", "helpfulCount", "verifiedVisitor", "visibility", "createdAt", "updatedAt"]
    },
    "LiveQueueStatusUpdate": {
      "title": "LiveQueueStatusUpdate",
      "description": "Live radar status update from citizens or desk staff",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "centreId": { "type": "string" },
        "centreName": { "type": "string" },
        "reporterName": { "type": "string" },
